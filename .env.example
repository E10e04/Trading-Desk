# Copiez ce fichier en .env et renseignez vos valeurs. .env est ignoré par Git.

# --- OpenRouter (IA) : la clé reste côté backend uniquement ---
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=minimax/minimax-m3.1-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- BiQuote (flux de marché) ---
BIQUOTE_BASE_URL=https://biquote.io
BIQUOTE_HUB_PATH=/hubs/tick
# Optionnel (l'API est ouverte sans clé)
BIQUOTE_API_KEY=

# --- SEC EDGAR (skills News / Analyst) : "Prénom Nom adresse@email" ---
SEC_USER_AGENT=

# --- Application ---
TRADING_DATA_DIR=./data
TRADING_DB_URL=sqlite:///./data/trading.sqlite
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8787
# Origines autorisées pour le navigateur (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Jeton local partagé entre l'interface et le backend (laisser vide = généré au démarrage)
API_TOKEN=
